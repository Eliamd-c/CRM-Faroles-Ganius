# Meta / Instagram Graph API Credentials
# DOC: https://developers.facebook.com/documentation/instagram-platform/instagram-api-with-facebook-login
PAGE_ACCESS_TOKEN=your_page_access_token_here
INSTAGRAM_ACCOUNT_ID=your_instagram_account_id_here
VERIFY_TOKEN=your_verify_token_here

PORT=3000

# Backend Security (Obligatorio)
API_SECRET=your_secret_admin_key_here
META_APP_SECRET=your_meta_app_secret_here

# Supabase Database Credentials
SUPABASE_URL=your_supabase_project_url_here
SUPABASE_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# OpenAI API
OPENAI_API_KEY=your_openai_api_key_here
